<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.facturacion.controller.ProductoController"
            stylesheets="@../styles/app.css">

    <!-- =====================================================
         ENCABEZADO
         ===================================================== -->

    <top>

        <HBox styleClass="header"
              alignment="CENTER_LEFT">

            <VBox spacing="2">

                <Label text="Gestión de productos"
                       styleClass="header-title"/>

                <Label text="Registro y administración del catálogo"
                       styleClass="header-subtitle"/>

            </VBox>

        </HBox>

    </top>


    <!-- =====================================================
         CONTENIDO PRINCIPAL
         ===================================================== -->

    <center>

        <HBox styleClass="content-area"
              spacing="18">


            <!-- =================================================
                 FORMULARIO
                 ================================================= -->

            <VBox styleClass="card product-form"
                  prefWidth="330"
                  minWidth="310"
                  maxWidth="350"
                  spacing="6">

                <Label text="Información del producto"
                       styleClass="card-title"/>

                <Label text="Ingrese los datos correspondientes."
                       styleClass="card-subtitle"/>


                <!-- CÓDIGO -->

                <Label text="Código"
                       styleClass="label-form"/>

                <TextField fx:id="txtCodigo"
                           prefHeight="32"
                           promptText="Ej. PROD-001">

                    <tooltip>
                        <Tooltip text="Código del producto&#10;Identificador del producto dentro del sistema."/>
                    </tooltip>

                </TextField>


                <!-- NOMBRE -->

                <Label text="Nombre"
                       styleClass="label-form"/>

                <TextField fx:id="txtNombre"
                           prefHeight="32"
                           promptText="Nombre del producto">

                    <tooltip>
                        <Tooltip text="Nombre del producto&#10;Ingrese el nombre que tendrá el producto."/>
                    </tooltip>

                </TextField>


                <!-- CATEGORÍA -->

                <Label text="Categoría"
                       styleClass="label-form"/>

                <ComboBox fx:id="cmbCategoria"
                          prefHeight="32"
                          maxWidth="Infinity"
                          promptText="Seleccione una categoría">

                    <tooltip>
                        <Tooltip text="Categoría&#10;Seleccione la categoría a la que pertenece el producto."/>
                    </tooltip>

                </ComboBox>


                <!-- PRECIO Y EXISTENCIA -->

                <HBox spacing="10">

                    <VBox spacing="5"
                          HBox.hgrow="ALWAYS">

                        <Label text="Precio de venta"
                               styleClass="label-form"/>

                        <TextField fx:id="txtPrecio"
                                   prefHeight="32"
                                   promptText="Ej. 150.00">

                            <tooltip>
                                <Tooltip text="Precio de venta&#10;Ingrese un precio mayor que cero."/>
                            </tooltip>

                        </TextField>

                    </VBox>


                    <VBox spacing="5"
                          HBox.hgrow="ALWAYS">

                        <Label text="Existencia"
                               styleClass="label-form"/>

                        <TextField fx:id="txtExistencia"
                                   prefHeight="32"
                                   promptText="Ej. 25">

                            <tooltip>
                                <Tooltip text="Existencia&#10;Cantidad disponible del producto."/>
                            </tooltip>

                        </TextField>

                    </VBox>

                </HBox>


                <!-- ESTADO -->

                <CheckBox fx:id="chkActivo"
                          text="Producto activo">

                    <tooltip>
                        <Tooltip text="Estado del producto&#10;Indica si el producto se encuentra activo."/>
                    </tooltip>

                </CheckBox>


                <!-- =================================================
                     VISTA PREVIA
                     ================================================= -->

                <VBox styleClass="image-container"
                      alignment="CENTER"
                      spacing="3"
                      prefHeight="82"
                      minHeight="82"
                      maxHeight="82">

                    <ImageView fx:id="imgProducto"
                               fitWidth="80"
                               fitHeight="52"
                               preserveRatio="true"/>

                    <Label text="Vista previa de imagen"
                           styleClass="image-placeholder"/>

                </VBox>


                <!-- IMAGEN -->

                <Button fx:id="btnImagen"
                        text="Seleccionar imagen"
                        styleClass="button-secondary"
                        onAction="#seleccionarImagen"
                        prefHeight="31"
                        maxWidth="Infinity">

                    <tooltip>
                        <Tooltip text="Seleccionar imagen&#10;Permite elegir una imagen para el producto."/>
                    </tooltip>

                </Button>


                <!-- =================================================
                     ACCIONES
                     ================================================= -->

                <HBox spacing="8">

                    <Button fx:id="btnGuardar"
                            text="Guardar producto"
                            styleClass="button-success"
                            onAction="#guardar"
                            prefHeight="34"
                            maxWidth="Infinity"
                            HBox.hgrow="ALWAYS">

                        <tooltip>
                            <Tooltip text="Guardar producto&#10;Registra el producto con los datos ingresados."/>
                        </tooltip>

                    </Button>


                    <Button fx:id="btnCerrar"
                            text="Cerrar"
                            styleClass="button-danger"
                            onAction="#cerrar"
                            prefHeight="34">

                        <tooltip>
                            <Tooltip text="Cerrar ventana&#10;Cierra la gestión de productos."/>
                        </tooltip>

                    </Button>

                </HBox>

            </VBox>


            <!-- =================================================
                 TABLA
                 ================================================= -->

            <VBox styleClass="card"
                  spacing="10"
                  HBox.hgrow="ALWAYS">

                <Label text="Productos registrados"
                       styleClass="card-title"/>

                <Label text="Busque productos por código, nombre o categoría."
                       styleClass="card-subtitle"/>


                <!-- BÚSQUEDA -->

                <HBox spacing="8"
                      alignment="CENTER_LEFT">

                    <TextField fx:id="txtBuscar"
                               promptText="Buscar por código, nombre o categoría..."
                               prefHeight="34"
                               HBox.hgrow="ALWAYS">

                        <tooltip>
                            <Tooltip text="Buscar productos&#10;Filtra el listado por código, nombre o categoría."/>
                        </tooltip>

                    </TextField>


                    <Button fx:id="btnLimpiarBusqueda"
                            text="Limpiar"
                            styleClass="button-secondary"
                            prefHeight="34"
                            onAction="#limpiarBusqueda">

                        <tooltip>
                            <Tooltip text="Limpiar búsqueda&#10;Muestra nuevamente todos los productos."/>
                        </tooltip>

                    </Button>

                </HBox>


                <!-- TABLA -->

                <TableView fx:id="tblProductos"
                           VBox.vgrow="ALWAYS"
                           minHeight="250">

                    <columns>

                        <TableColumn fx:id="colCodigo"
                                     text="Código"
                                     prefWidth="100"/>

                        <TableColumn fx:id="colNombre"
                                     text="Nombre"
                                     prefWidth="170"/>

                        <TableColumn fx:id="colCategoria"
                                     text="Categoría"
                                     prefWidth="110"/>

                        <TableColumn fx:id="colPrecio"
                                     text="Precio"
                                     prefWidth="90"/>

                        <TableColumn fx:id="colExistencia"
                                     text="Existencia"
                                     prefWidth="90"/>

                        <TableColumn fx:id="colActivo"
                                     text="Estado"
                                     prefWidth="80"/>

                    </columns>

                </TableView>


                <Label fx:id="lblContador"
                       text="Mostrando 0 productos"
                       styleClass="status-label"/>

            </VBox>

        </HBox>

    </center>


    <!-- =====================================================
         PIE
         ===================================================== -->

    <bottom>

        <HBox styleClass="status-bar"
              alignment="CENTER_LEFT">

            <Label text="Gestión de productos • Sistema de Facturación"
                   styleClass="status-label"/>

        </HBox>

    </bottom>

</BorderPane>