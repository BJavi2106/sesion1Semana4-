<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.facturacion.controller.MenuPrincipalController"
            stylesheets="@../styles/app.css">

    <!-- ENCABEZADO -->

    <top>

        <VBox>

            <HBox styleClass="header"
                  alignment="CENTER_LEFT">

                <VBox spacing="2">

                    <Label text="EL GÜEGÜENSE"
                           styleClass="brand-title"/>

                    <Label text="Sistema de Facturación"
                           styleClass="brand-subtitle"/>

                </VBox>

            </HBox>


            <!-- MENÚ -->

            <MenuBar styleClass="main-menu">

                <Menu text="Sistema">

                    <MenuItem text="Productos"
                              onAction="#abrirProductos"/>

                    <MenuItem text="Salir"
                              onAction="#salir"/>

                </Menu>

                <Menu text="Ayuda">

                    <MenuItem text="Acerca del sistema"
                              onAction="#acercaDe"/>

                </Menu>

            </MenuBar>


            <!-- BARRA DE ACCIONES -->

            <HBox styleClass="toolbar"
                  spacing="10"
                  alignment="CENTER_LEFT">

                <Button text="Productos"
                        styleClass="button-primary"
                        onAction="#abrirProductos">

                    <tooltip>

                        <Tooltip text="Gestión de productos&#10;Administra el catálogo de productos del sistema."/>

                    </tooltip>

                </Button>


                <Button text="Salir"
                        styleClass="button-danger"
                        onAction="#salir">

                    <tooltip>

                        <Tooltip text="Salir&#10;Cierra el sistema de facturación."/>

                    </tooltip>

                </Button>

            </HBox>

        </VBox>

    </top>


    <!-- PANEL PRINCIPAL -->

    <center>

        <VBox styleClass="dashboard"
              spacing="20">

            <VBox spacing="4">

                <Label text="Panel principal"
                       styleClass="dashboard-title"/>

                <Label text="Seleccione una opción para comenzar a trabajar."
                       styleClass="dashboard-subtitle"/>

            </VBox>


            <!-- TARJETAS -->

            <HBox spacing="18"
                  VBox.vgrow="ALWAYS">


                <!-- PRODUCTOS -->

                <VBox styleClass="dashboard-card"
                      spacing="10"
                      HBox.hgrow="ALWAYS">

                    <Label text="Productos"
                           styleClass="dashboard-card-title"/>

                    <Label text="Administre el catálogo de productos, precios, existencia e imágenes."
                           wrapText="true"
                           styleClass="dashboard-card-text"
                           VBox.vgrow="ALWAYS"/>

                    <Button text="Abrir productos"
                            styleClass="button-primary"
                            onAction="#abrirProductos">

                        <tooltip>

                            <Tooltip text="Abrir gestión de productos&#10;Permite registrar y consultar productos."/>

                        </tooltip>

                    </Button>

                </VBox>


                <!-- SISTEMA -->

                <VBox styleClass="dashboard-card"
                      spacing="10"
                      HBox.hgrow="ALWAYS">

                    <Label text="Sistema"
                           styleClass="dashboard-card-title"/>

                    <Label text="Herramientas principales del sistema de facturación."
                           wrapText="true"
                           styleClass="dashboard-card-text"
                           VBox.vgrow="ALWAYS"/>

                </VBox>


                <!-- INFORMACIÓN -->

                <VBox styleClass="dashboard-card"
                      spacing="10"
                      HBox.hgrow="ALWAYS">

                    <Label text="Información"
                           styleClass="dashboard-card-title"/>

                    <Label text="Sistema desarrollado para la gestión y control de productos."
                           wrapText="true"
                           styleClass="dashboard-card-text"
                           VBox.vgrow="ALWAYS"/>

                </VBox>

            </HBox>

        </VBox>

    </center>


    <!-- PIE -->

    <bottom>

        <HBox styleClass="status-bar"
              alignment="CENTER_LEFT">

            <Label text="Sistema de Facturación • UAM"
                   styleClass="status-label"/>

        </HBox>

    </bottom>

</BorderPane>